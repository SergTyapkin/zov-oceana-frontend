@import 'constants.styl'
@import 'fonts.styl'
@import 'buttons.styl'
@import 'utils.styl'

page-root()
  // box-sizing content-box
  min-width 100%
  padding-top 30px
  padding-bottom 70px
  padding-inline 'max(calc((100vw - %s) / 2), %s)' % (pageMaxWidth pageMinHorizontalPadding)

  @media ({mobile})
    padding-inline 'max(calc((100vw - %s) / 2), %s)' % (pageMaxWidth pageMinHorizontalPaddingMobile)

page-root-disable()
  min-width 100%
  margin-inline 'min(calc((100vw - %s) / -2), -%s)' % (pageMaxWidth pageMinHorizontalPadding)

  @media ({mobile})
    margin-inline 'min(calc((100vw - %s) / -2), -%s)' % (pageMaxWidth pageMinHorizontalPaddingMobile)

block(colorBorder=colorBorder)
  display block
  padding 15px
  border 1px solid colorBorder
  border-radius 8px
  header
    font-medium()
    font-normal()

block-emp(colorBorder=colorEmp2, colorBg=colorBlockBgEmp2)
  block()

  border-color colorBorder
  color colorTextInvert1
  // background colorBg
  background url('/static/images/ocean-bg.jpg')

block-bg(colorBg=colorBlockBg)
  block()

  background colorBg

block-glass(colorBorder=colorBorder, colorBg=colorBlockBgEmp2)
  block()

  border-top-color mix(colorBorder, transparent, 40%)
  border-right-color mix(colorBorder, transparent, 20%)
  border-bottom-color mix(colorBorder, transparent, 20%)
  border-left-color mix(colorBorder, transparent, 40%)
  background mix(colorBg, transparent, 20%)
  backdrop-filter blur(15px)

input()
  input-no-styles()

  cursor text
  display flex
  align-items center
  margin 0
  padding 10px 15px
  border none
  color colorText1
  background colorBlockBgLow
  font-small()

  &::placeholder
    color colorText2

  &:focus
    border-color colorEmp1
    // color colorEmp1
    background colorSuccessBg
  &.error
    border-color colorError
  &.success
    border-color colorSuccess
  &[disabled]:not([disabled="false"])
    cursor default
    color colorText2

  trans()
