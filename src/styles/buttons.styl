@import 'constants.styl'
@import 'fonts.styl'
@import 'utils.styl'


button(marginLeft=0px, marginRight=10px)
  cursor pointer
  user-select none
  box-sizing border-box
  padding 12px 30px
  border none
  color colorText1
  text-shadow none
  background colorBlockBg
  transition all 0.2s ease

  &:hover
    background mix(black, colorBlockBg, 20%)

  &[disabled]:not([disabled="false"])
    pointer-events none
    color mix(white, colorText1, 70%)
    background mix(white, colorBlockBg, 50%)
    box-shadow none

  @media ({mobile})
    padding-inline 15px
  font-small()
  font-spaced()
  font-normal()
  font-upper()
  svg-inside(1lh, marginLeft, marginRight)
  trans()
  centered-flex-container()

button-no-fill()
  button()

  border-color transparent
  color colorTextInvert1
  background transparent

  &:hover
    border-color mix(colorBlockBg, white, 20%)
    color colorText1
    background mix(colorBlockBg, white, 20%)

button-emp1(marginLeft=0px, marginRight=10px)
  button(marginLeft, marginRight)

  border-color transparent
  color colorTextInvert1
  background colorEmp1

  &:hover
    border-color transparent
    color colorTextInvert1
    background colorEmp1Hover

button-emp2(marginLeft=0px, marginRight=10px)
  button-emp1(marginLeft, marginRight)

  background colorEmp2

  &:hover
    background colorEmp2Hover


button-emp1-no-fill(marginLeft=0px, marginRight=10px)
  button-emp1(marginLeft, marginRight)

  padding-right 10px
  padding-left 10px
  border colorEmp1 1px solid
  color colorEmp1
  background transparent

  &:hover
    border-color mix(colorBlockBg, white, 20%)
    color colorEmp1
    background mix(colorEmp1, white, 20%)

button-emp2-no-fill(marginLeft=0px, marginRight=10px)
  button-emp2(marginLeft, marginRight)

  padding-right 10px
  padding-left 10px
  border colorEmp2 1px solid
  color colorEmp2
  background transparent

  &:hover
    border-color mix(colorBlockBg, white, 20%)
    color colorText1
    background mix(colorEmp2, white, 20%)


button-error(marginLeft=0px, marginRight=10px)
  button(marginLeft, marginRight)

  border-color colorError
  color colorTextInvert1
  background colorError

  &:hover
    border-color mix(colorError, white)
    color colorTextInvert1
    background mix(colorError, white)

button-success(marginLeft=0px, marginRight=10px)
  button(marginLeft, marginRight)

  border-color colorSuccess
  color colorTextInvert1
  background mix(colorSuccess, transparent, 90%)

  &:hover
    border-color mix(colorSuccess, white)
    color colorTextInvert1

button-small()
  font-small-extra()

  padding 7px 10px
  text-transform none

